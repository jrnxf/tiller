# What a score depends on, pinned so a change in any of them is a visible
# commit rather than a silent drift (plan-v2 point 22). Change one at a time;
# a pin change re-baselines both splits.

# The Claude Code release the evals were scored on. run.sh warns when the
# installed CLI differs, and stops in CI or on the holdout. The evals dev
# shell gets Claude Code from the locked nixpkgs, so update this with
# flake.lock.
CLAUDE_CODE_VERSION=2.1.312

# The model each role's frontmatter alias resolves to under test.
MODEL_opus=claude-opus-5-5
MODEL_fable=claude-fable-5-1
MODEL_sonnet=claude-sonnet-5-5

# The judge for every llm grader. The rubrics it reads are pinned by
# evals/judge.lock.
JUDGE_MODEL=claude-sonnet-5-5
